# Smart Attendance Management System Environment Configuration

# PostgreSQL Connection String (Optional for Local SQLite, Required for Production / Vercel with PostgreSQL)
# Format: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=

# Admin Master Password for Protected Admin Portal (Default: admin@2008)
ADMIN_PASSWORD=admin@2008

# Flask / Session Secret Key
SECRET_KEY=smart_attendance_secret_key_college_project_production

# Optional Gemini API key if additional AI features are enabled
GEMINI_API_KEY=
